{
  "family": "jobber-search",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::019720628733:role/jobber-ecs-execution",
  "taskRoleArn": "arn:aws:iam::019720628733:role/jobber-task-search",
  "containerDefinitions": [
    {
      "name": "search",
      "image": "019720628733.dkr.ecr.us-east-1.amazonaws.com/jobber/search:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 8084, "protocol": "tcp" }],
      "environment": [
        { "name": "APPCONFIG_PROFILE", "value": "search" }
      ],
      "secrets": [
        { "name": "SEARCH_DB_PASSWORD", "valueFrom": "arn:aws:ssm:us-east-1:019720628733:parameter/jobber/db/password" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jobber-search",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "search"
        }
      }
    },
    {
      "name": "appconfig-agent",
      "image": "public.ecr.aws/aws-appconfig/aws-appconfig-agent:2.x",
      "essential": false,
      "environment": [{ "name": "AWS_REGION", "value": "us-east-1" }],
      "portMappings": [{ "containerPort": 2772, "protocol": "tcp" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/jobber-search",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "appconfig"
        }
      }
    }
  ]
}
