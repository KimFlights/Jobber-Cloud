{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadJobberParams",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-east-1:019720628733:parameter/jobber/*"
    },
    {
      "Sid": "DecryptWithJobberKey",
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "arn:aws:kms:us-east-1:019720628733:key/1dcb4d96-b1fd-46dd-ad43-a176d0783770"
    }
  ]
}
